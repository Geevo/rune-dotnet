<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(RuneTfm)</TargetFramework>
    <TargetFramework Condition="'$(RuneTfm)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>todo</AssemblyName>
    <RuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeFrameworkVersion Condition="'$(RuneTfm)' == ''">10.0.15</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <!-- Size. None of these change Rune's behaviour. -->
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <StackTraceSupport>false</StackTraceSupport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebuggerSupport>false</DebuggerSupport>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Rune/Rune.csproj" />
    <!-- The SDK's default ILCompiler can be one with a high-severity advisory (GHSA-p3jp-9v83-76w9).
         RuntimeFrameworkVersion keeps the runtime packs at the same version, or publish finds no NativeAOT pack. -->
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.15" Condition="'$(RuneTfm)' == ''" />
  </ItemGroup>
  <Import Project="../../src/Rune/Rune.targets" />
</Project>
