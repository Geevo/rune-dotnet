<!-- Links the Rust static library straight into the NativeAOT executable. Apps get this from the
     RuneDotNet package (buildTransitive/RuneDotNet.targets imports it), or import it from the
     source tree. NativeAOT only builds for the OS it runs on, so the host decides. The library
     lists come from rustc's native-static-libs note. -->
<Project>
  <PropertyGroup>
    <RuneRoot Condition="'$(RuneRoot)' == ''">$(MSBuildThisFileDirectory)../../</RuneRoot>
    <RuneIsWindows>$([MSBuild]::IsOSPlatform('Windows'))</RuneIsWindows>
    <RuneIsLinux>$([MSBuild]::IsOSPlatform('Linux'))</RuneIsLinux>
    <RuneIsMac>$([MSBuild]::IsOSPlatform('OSX'))</RuneIsMac>
    <RuneCargoHome>$(CARGO_HOME)</RuneCargoHome>
    <RuneCargoHome Condition="'$(RuneCargoHome)' == '' And '$(RuneIsWindows)' == 'true'">$(USERPROFILE)/.cargo</RuneCargoHome>
  </PropertyGroup>

  <ItemGroup>
    <!-- P/Invokes become direct calls resolved at link time: no dlopen, no .so beside the app. -->
    <DirectPInvoke Include="rune_capi" />
  </ItemGroup>

  <Target Name="RuneRequiresAot" BeforeTargets="Build" Condition="'$(PublishAot)' != 'true' And '$(IsPublishable)' != 'false' And '$(OutputType)' != 'Library'">
    <Warning Text="Rune is a static library linked by NativeAOT: set PublishAot to true and run the app with dotnet publish. A JIT build can't load it." />
  </Target>

  <!-- A target, so RuntimeIdentifier is final by the time the package's library is picked. -->
  <Target Name="RuneNativeLibraries" BeforeTargets="SetupOSSpecificProps">
    <PropertyGroup>
      <RuneArch>x86_64</RuneArch>
      <RuneArch Condition="$(RuntimeIdentifier.EndsWith('arm64'))">aarch64</RuneArch>
      <!-- Set by the package: native/<rid>/. Otherwise, the source tree's Cargo output. -->
      <RuneNativeDir Condition="'$(RuneNativeDir)' == '' And '$(RunePackageRoot)' != ''">$(RunePackageRoot)native/$(RuntimeIdentifier)/</RuneNativeDir>
      <RuneLib Condition="'$(RuneLib)' == '' And '$(RuneNativeDir)' != '' And '$(RuneIsWindows)' == 'true'">$(RuneNativeDir)rune_capi.lib</RuneLib>
      <RuneLib Condition="'$(RuneLib)' == '' And '$(RuneNativeDir)' != ''">$(RuneNativeDir)librune_capi.a</RuneLib>
      <RuneLib Condition="'$(RuneLib)' == '' And '$(RuneIsWindows)' == 'true'">$(RuneRoot)target/release/rune_capi.lib</RuneLib>
      <RuneLib Condition="'$(RuneLib)' == ''">$(RuneRoot)target/release/librune_capi.a</RuneLib>
      <RuneShimDir>$(IntermediateOutputPath)rune-linkshim/</RuneShimDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(RuneLib)') And '$(RunePackageRoot)' != ''" Text="RuneDotNet has no native library for $(RuntimeIdentifier). It ships linux-x64, win-x64 and osx-arm64." />
    <Error Condition="!Exists('$(RuneLib)') And '$(RunePackageRoot)' == ''" Text="$(RuneLib) is missing: build it with cargo build --release --lib in native/rune-capi." />

    <ItemGroup>
      <NativeLibrary Include="$(RuneLib)" />
    </ItemGroup>

    <!-- Linking needs libxkbcommon.so, which comes with the development package. Without it, a link
         to the runtime library stands in, as the shim in native/rune-capi/build.rs does for Cargo. -->
    <ItemGroup Condition="'$(RuneIsLinux)' == 'true'">
      <RuneLibDir Include="/usr/lib64;/usr/lib/x86_64-linux-gnu;/usr/lib/aarch64-linux-gnu;/usr/lib;/lib64;/lib" />
      <RuneDevLib Include="%(RuneLibDir.Identity)/libxkbcommon.so" Condition="Exists('%(RuneLibDir.Identity)/libxkbcommon.so')" />
      <RuneRuntimeLib Include="%(RuneLibDir.Identity)/libxkbcommon.so.0" Condition="Exists('%(RuneLibDir.Identity)/libxkbcommon.so.0')" />
    </ItemGroup>
    <PropertyGroup Condition="'$(RuneIsLinux)' == 'true' And '@(RuneDevLib)' == '' And '@(RuneRuntimeLib)' != ''">
      <RuneShimTarget>%(RuneRuntimeLib.Identity)</RuneShimTarget>
    </PropertyGroup>
    <MakeDir Condition="'$(RuneShimTarget)' != ''" Directories="$(RuneShimDir)" />
    <Exec Condition="'$(RuneShimTarget)' != ''" Command="ln -sf &quot;$(RuneShimTarget)&quot; &quot;$(RuneShimDir)libxkbcommon.so&quot;" />

    <ItemGroup Condition="'$(RuneIsLinux)' == 'true'">
      <LinkerArg Include="-L$(RuneShimDir)" Condition="'$(RuneShimTarget)' != ''" />
      <!-- Only keep the DT_NEEDED entry if the app reaches xkbcommon, as a plain Rust link does. -->
      <LinkerArg Include="-Wl,--as-needed" />
      <LinkerArg Include="-lxkbcommon" />
      <LinkerArg Include="-lgcc_s;-lutil;-lrt;-lpthread;-lm;-ldl;-lc" />
    </ItemGroup>
    <ItemGroup Condition="'$(RuneIsMac)' == 'true'">
      <LinkerArg Include="-framework AppKit;-framework ApplicationServices;-framework AVFoundation;-framework Carbon" />
      <LinkerArg Include="-framework CoreAudio;-framework CoreFoundation;-framework CoreGraphics;-framework CoreMedia" />
      <LinkerArg Include="-framework CoreServices;-framework CoreVideo;-framework Foundation;-framework IOSurface" />
      <LinkerArg Include="-framework Metal;-framework QuartzCore;-lobjc;-liconv" />
    </ItemGroup>
    <ItemGroup Condition="'$(RuneIsWindows)' == 'true'">
      <NativeLibrary Include="user32.lib;shell32.lib;gdi32.lib;advapi32.lib;ntdll.lib;userenv.lib;ws2_32.lib;dbghelp.lib" />
      <!-- The import library of the `windows-targets` crate: the package ships it, and from source
           only Cargo knows its path. -->
      <NativeLibrary Condition="'$(RuneNativeDir)' != ''" Include="$(RuneNativeDir)windows.0.52.0.lib" />
      <NativeLibrary Condition="'$(RuneNativeDir)' == ''" Include="$(RuneCargoHome)/registry/src/*/windows_$(RuneArch)_msvc-0.52.*/lib/windows.0.52.0.lib" />
    </ItemGroup>
  </Target>
</Project>
